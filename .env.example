# =============================================================================
# LEWS (Landslide Early Warning System) - Environment Variables Template
# =============================================================================
# Copy this file to .env for local configuration:
# Linux/macOS: cp .env.example .env
# Windows PowerShell: Copy-Item .env.example .env
# =============================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# NASA EONET Live Natural Events Feed Endpoint (Optional override)
# Default: https://eonet.gsfc.nasa.gov/api/v3/events?category=landslides&status=open&limit=100
NASA_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3/events?category=landslides&status=open&limit=100

# Database Configuration (Optional for prototype / MySQL or PostgreSQL via Drizzle)
# DATABASE_URL=mysql://user:password@localhost:3306/lews_db

# Session / JWT Secret (Optional for authenticated sessions)
# JWT_SECRET=your-random-secure-secret-key-at-least-32-chars

# AI / LLM Provider Configuration (Optional built-in proxy)
# BUILT_IN_FORGE_API_URL=https://forge.butterfly-effect.dev
# BUILT_IN_FORGE_API_KEY=your-api-key-here
